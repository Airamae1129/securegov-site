# Copy to backend/.env for local development. backend/.env is git-ignored — never commit it.

# A real MongoDB connection string, or mongomock:// for an in-memory database (resets on restart)
MONGO_URL=mongomock://
DB_NAME=securegov
CORS_ORIGINS=*

# Admin side (/admin)
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
# First administrator — created on startup only while no staff accounts exist
ADMIN_EMAIL=admin@securegov.local
ADMIN_PASSWORD=Admin123
ADMIN_NAME=Local Admin
