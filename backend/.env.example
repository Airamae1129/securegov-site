# Copy to backend/.env for local development. backend/.env is git-ignored — never commit it.

# A real MongoDB connection string, or mongomock:// for an in-memory database (resets on restart)
MONGO_URL=mongomock://
DB_NAME=securegov
CORS_ORIGINS=*

# Admin side (/admin)
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
# First administrator — created on startup only while no staff accounts exist
ADMIN_EMAIL=admin@securegov.local
ADMIN_PASSWORD=Admin123
ADMIN_NAME=Local Admin

# Email alerts for new inquiries (optional — leave SMTP_HOST empty to switch them off)
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureGov Website <alerts@example.com>
# Comma-separated inboxes that receive an email for every new inquiry
NOTIFY_EMAILS=
ADMIN_URL=http://localhost:3000/admin/messages
